# =====================================================================
# Sentinel configuration (copy to .env and fill in). Everything is LOCAL
# except the free-tier reputation APIs, which are optional.
# =====================================================================

# --- LLM provider -----------------------------------------------------
# "ollama" (default, local) or "openai" = any OpenAI-compatible
# /chat/completions endpoint (hosted gateway, vLLM, LM Studio, ...).
LLM_PROVIDER=ollama
OPENAI_BASE_URL=                # e.g. https://api.example.com/v1
OPENAI_API_KEY=                 # only for LLM_PROVIDER=openai
OPENAI_MODEL=                   # e.g. hy3, gpt-4o-mini, qwen2.5:7b ...

# --- Local LLM (Ollama) ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b        # or qwen2.5:7b / qwen2.5:14b (tool-calling capable)

# --- Reputation APIs (optional, free-tier) ---------------------------
VIRUSTOTAL_API_KEY=             # https://www.virustotal.com -> API key
ABUSEIPDB_API_KEY=              # https://www.abuseipdb.com -> API v2 key
IPINFO_TOKEN=                   # optional; ip-api.com needs no key for basic lookups

# --- GeoIP offline DB (optional; if present, geolocate_ip cross-validates) --
MAXMIND_GEOLITE2_PATH=          # path/to/GeoLite2-City.mmdb

# --- Blockchain ------------------------------------------------------
BLOCKCHAIN_MODE=hashchain        # "hashchain" (default) or "ganache"
GANACHE_RPC_URL=http://127.0.0.1:8545
GANACHE_ACCOUNT=0x0000000000000000000000000000000000000000
LEDGER_PATH=evidence/ledger.chain.json

# --- Safety ----------------------------------------------------------
TOOL_TIMEOUT_SECONDS=15
SANDBOX_ENABLED=1                # 1 = enforce Docker sandbox for file-touching ops

# --- Sentinel Web API Key Authentication ------------------------------
# NEVER put a real API key inside .env.example!
# API Keys are generated securely via the Web Dashboard or API (/api/keys/generate).
# Generated keys use Bearer Token format: Authorization: Bearer <API_KEY>
# Raw keys are never stored; only SHA-256 key hashes are persisted locally.
SENTINEL_API_KEY_REQUIRED=true

