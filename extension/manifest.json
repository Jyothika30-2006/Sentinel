{
  "manifest_version": 3,
  "name": "Sentinel Guard Connector",
  "version": "1.0.0",
  "description": "Activates the local Sentinel agent only when you open a mail in Gmail. No account access — posts the opened message to your local Sentinel server.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel Guard Connector"
  }
}
